
{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "GUS BDL API data response",
    "type": "object",
    "required": [
        "results"
    ],
    "properties": {
        "results": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "values"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                    },
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                    },
                    "values": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "year",
                                "val"
                            ],
                            "properties": {
                                "year": {
                                    "type": "string",
                                    "pattern": "^[0-9]{4}$"
                                },
                                "val": {
                                    "type": "number",
                                    "minimum": 0
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
